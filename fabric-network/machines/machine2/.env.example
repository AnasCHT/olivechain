M3_IP=192.168.10.103
M4_IP=192.168.10.104
MACHINE_IP=192.168.10.102
MACHINE_FQDN=machine2.olivechain.local

# Replace every example secret before running a CA.
CA_ADMIN_PASSWORD='replace-peer-ca-bootstrap-password'
PEER_ADMIN_ENROLL_SECRET='replace-peer-admin-secret'
PEER_NODE_ENROLL_SECRET='replace-peer-node-secret'
PEER_APP_ENROLL_SECRET='replace-peer-app-secret'
COUCHDB_USER='olivechain_peer'
COUCHDB_PASSWORD='replace-couchdb-password'

ORDERER_CA_ADMIN_PASSWORD='replace-orderer-ca-bootstrap-password'
ORDERER_ADMIN_ENROLL_SECRET='replace-orderer-admin-secret'
ORDERER_NODE_ENROLL_SECRET='replace-orderer-node-secret'
OSNADMIN_ENROLL_SECRET='replace-osnadmin-secret'
