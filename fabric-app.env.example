# OliveChain Wallet + Incentives 1.0
OLIVECHAIN_LEDGER_BACKEND=fabric

# One long random value shared only by FastAPI and all four Gateway Agents.
OLIVECHAIN_AGENT_TOKEN=replace-with-at-least-32-random-bytes

# Gateway Agent URLs as seen from Machine 1 (FastAPI host).
OLIVECHAIN_AGENT_URL_FARMER=http://127.0.0.1:9080
OLIVECHAIN_AGENT_URL_MAKER=http://MACHINE2_IP:9080
OLIVECHAIN_AGENT_URL_COURIER=http://MACHINE3_IP:9080
OLIVECHAIN_AGENT_URL_RECYCLER=http://MACHINE4_IP:9080
OLIVECHAIN_AGENT_TIMEOUT_S=30

# Passwordless wallet application sessions.
# If unset, a local secret is generated at data/wallet_session_secret.
# OLIVECHAIN_WALLET_SESSION_SECRET=replace-with-another-long-random-value
OLIVECHAIN_WALLET_SESSION_TTL_S=28800
OLIVECHAIN_WALLET_COOKIE_SECURE=false
# Change to true when the portal is served over HTTPS.

# Optional outer operator Basic Auth for non-public administration surfaces.
# This is infrastructure protection, not an OliveChain user password/login.
# OLIVECHAIN_ADMIN_USER=operator
# OLIVECHAIN_ADMIN_PASSWORD=replace-me

# Website access from other devices on the same LAN.
OLIVECHAIN_APP_BIND=0.0.0.0
OLIVECHAIN_APP_PORT=8000
# OLIVECHAIN_LAN_IP=192.168.10.101

# Optional system Python interpreter containing requirements.
# OLIVECHAIN_PYTHON=/Library/Frameworks/Python.framework/Versions/3.13/bin/python3
