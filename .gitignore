*.pyc
.pytest_cache/
*.log
js_out.json
.DS_Store
._*
node_modules/
.venv/
venv/
*.key
*_secret
password_users.txt

# Hyperledger Fabric multi-machine runtime (contains private keys and ledgers)
fabric-network/machines/*/.env
fabric-network/runtime/*
fabric-network/public-artifacts/current/*
